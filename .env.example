# ==========================================
# AI CREATOR OS - ENVIRONMENT CONFIGURATION
# ==========================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------
# SUPABASE CONFIGURATION (Database & Auth - Optional)
# ------------------------------------------
# Leave empty to run in local persistent storage mode
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------
# AI PROVIDERS (ZERO COST BY DEFAULT)
# ------------------------------------------
# Primary Provider: Local Ollama (Default: Enabled, Zero Cost)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2

# Optional Remote Providers (Disabled by default, requires user enablement)
# Groq Cloud API (Optional)
GROQ_API_KEY=
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile

# OpenRouter API (Optional)
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=meta-llama/llama-3.2-3b-instruct:free

# Local-Only Safety Switch ("true" blocks all remote AI calls)
LOCAL_ONLY_MODE=false

# ------------------------------------------
# RESEARCH & TOOLS
# ------------------------------------------
# GitHub API Token (Optional, for higher rate limits on repo research)
GITHUB_API_TOKEN=

# ------------------------------------------
# GOOGLE CALENDAR INTEGRATION (Optional OAuth)
# ------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/google/callback
